<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<main class="py-5 d-flex align-items-center flex-grow-1">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="tf-card p-4 p-md-5">
          <!-- Form Header -->
          <div class="text-center mb-4">
            <img src="/images/logo.svg" alt="TaskFlow" width="48" height="48" class="mb-2">
            <h1 class="h4 fw-bold text-dark">Join TaskFlow</h1>
            <p class="text-muted small mb-0">Create your personal account to manage tasks securely</p>
          </div>

          <!-- Alert Message -->
          <% if (message) { %>
            <div class="alert alert-<%= message.type %> alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 small mb-3">
              <i class="bi bi-exclamation-triangle-fill"></i>
              <div><%= message.text %></div>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% } %>

          <!-- Register Form -->
          <form action="/auth/register" method="POST">
            <div class="mb-3">
              <label for="regName" class="form-label">Full Name <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                <input 
                  type="text" 
                  class="form-control border-start-0 <%= errors && errors.name ? 'is-invalid' : '' %>" 
                  id="regName" 
                  name="name" 
                  placeholder="Alex Mercer" 
                  value="<%= formData && formData.name ? formData.name : '' %>"
                  required
                >
                <% if (errors && errors.name) { %>
                  <div class="invalid-feedback d-block"><%= errors.name %></div>
                <% } %>
              </div>
            </div>

            <div class="mb-3">
              <label for="regEmail" class="form-label">Email Address <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                <input 
                  type="email" 
                  class="form-control border-start-0 <%= errors && errors.email ? 'is-invalid' : '' %>" 
                  id="regEmail" 
                  name="email" 
                  placeholder="alex@example.com" 
                  value="<%= formData && formData.email ? formData.email : '' %>"
                  required
                >
                <% if (errors && errors.email) { %>
                  <div class="invalid-feedback d-block"><%= errors.email %></div>
                <% } %>
              </div>
            </div>

            <div class="mb-3">
              <label for="regPassword" class="form-label">Password <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                <input 
                  type="password" 
                  class="form-control border-start-0 <%= errors && errors.password ? 'is-invalid' : '' %>" 
                  id="regPassword" 
                  name="password" 
                  placeholder="Minimum 6 characters" 
                  required
                >
                <% if (errors && errors.password) { %>
                  <div class="invalid-feedback d-block"><%= errors.password %></div>
                <% } %>
              </div>
              <div class="form-text">Will be salted & hashed using bcrypt (10 rounds).</div>
            </div>

            <div class="mb-4">
              <label for="regConfirm" class="form-label">Confirm Password <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
                <input 
                  type="password" 
                  class="form-control border-start-0 <%= errors && errors.confirmPassword ? 'is-invalid' : '' %>" 
                  id="regConfirm" 
                  name="confirmPassword" 
                  placeholder="Re-type your password" 
                  required
                >
                <% if (errors && errors.confirmPassword) { %>
                  <div class="invalid-feedback d-block"><%= errors.confirmPassword %></div>
                <% } %>
              </div>
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-primary-tf py-2">
                <i class="bi bi-person-plus-fill me-1"></i> Create Secure Account
              </button>
            </div>
          </form>

          <div class="text-center mt-4 pt-3 border-top">
            <p class="small text-muted mb-0">
              Already have an account? 
              <a href="/auth/login" class="fw-semibold text-primary text-decoration-none">Sign In</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
