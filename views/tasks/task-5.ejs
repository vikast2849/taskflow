<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<main class="py-4">
  <div class="container container-xl">
    <!-- Internship Task Header Badge -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="badge bg-warning-subtle text-warning-emphasis border px-3 py-2 text-uppercase fw-bold letter-spacing-1">Cognifyz Level 3 : Task 5</span>
          <span class="badge bg-light text-dark border">Advanced</span>
        </div>
        <h1 class="h3 fw-bold mb-1">API Integration and Front-End Interaction</h1>
        <p class="text-muted mb-0">Full CRUD RESTful API with HTTP status codes, structured JSON responses, asynchronous <code>fetch()</code> client, and reactive loading/error states.</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/tasks/task-4" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i> Task 4
        </a>
        <a href="/tasks/task-6" class="btn btn-sm btn-primary-tf">
          Next: Task 6 <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>
    </div>

    <!-- REST API Endpoints Specification Card -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-bottom pb-2 mb-3">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-hdd-network-fill text-primary fs-5"></i>
          <h2 class="h6 fw-bold mb-0">Registered Express RESTful API Endpoints</h2>
        </div>
        <span class="badge bg-light text-dark border small">JSON Protocol</span>
      </div>

      <div class="row g-2 small">
        <div class="col-md-4 col-lg-2">
          <div class="p-2 border rounded bg-light">
            <span class="badge bg-success me-1">GET</span> <code>/api/tasks</code>
          </div>
        </div>
        <div class="col-md-4 col-lg-2">
          <div class="p-2 border rounded bg-light">
            <span class="badge bg-success me-1">GET</span> <code>/api/tasks/:id</code>
          </div>
        </div>
        <div class="col-md-4 col-lg-3">
          <div class="p-2 border rounded bg-light">
            <span class="badge bg-primary me-1">POST</span> <code>/api/tasks</code> (201)
          </div>
        </div>
        <div class="col-md-4 col-lg-2">
          <div class="p-2 border rounded bg-light">
            <span class="badge bg-warning text-dark me-1">PUT</span> <code>/api/tasks/:id</code>
          </div>
        </div>
        <div class="col-md-4 col-lg-3">
          <div class="p-2 border rounded bg-light">
            <span class="badge bg-danger me-1">DELETE</span> <code>/api/tasks/:id</code>
          </div>
        </div>
      </div>
    </div>

    <!-- Error Alert Container -->
    <div id="apiErrorBanner" class="alert alert-danger d-none d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4">
      <i class="bi bi-exclamation-triangle-fill fs-5"></i>
      <div id="apiErrorText" class="flex-grow-1"></div>
      <button type="button" class="btn-close" onclick="document.getElementById('apiErrorBanner').classList.add('d-none')"></button>
    </div>

    <!-- Main Workspace Container -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
      <!-- Search, Filter & Add Task Toolbar -->
      <div class="row g-3 align-items-center mb-4">
        <div class="col-md-4">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="apiSearchInput" class="form-control border-start-0" placeholder="Search tasks via API query...">
          </div>
        </div>
        <div class="col-md-5">
          <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-api-filter btn-primary active" data-status="all">All</button>
            <button class="btn btn-sm btn-api-filter btn-outline-secondary" data-status="pending">Pending</button>
            <button class="btn btn-sm btn-api-filter btn-outline-secondary" data-status="in-progress">In Progress</button>
            <button class="btn btn-sm btn-api-filter btn-outline-secondary" data-status="completed">Completed</button>
          </div>
        </div>
        <div class="col-md-3 text-md-end">
          <button class="btn btn-primary-tf btn-sm px-3" data-bs-toggle="modal" data-bs-target="#createTaskModal">
            <i class="bi bi-plus-lg me-1"></i> New Task (POST)
          </button>
        </div>
      </div>

      <!-- Loading State Spinner -->
      <div id="apiLoadingSpinner" class="text-center py-5 d-none">
        <div class="spinner-border text-primary" role="status">
          <span class="visually-hidden">Loading tasks...</span>
        </div>
        <p class="text-muted small mt-2">Communicating with REST API via <code>fetch()</code>...</p>
      </div>

      <!-- Task Grid -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="fw-bold text-dark small text-uppercase letter-spacing-1">API Managed Resources</span>
        <span id="apiTaskCount" class="badge bg-light text-secondary border">0 tasks</span>
      </div>

      <div id="apiTaskGrid" class="row">
        <!-- Rendered dynamically by task5-api.js -->
      </div>
    </div>
  </div>
</main>

<!-- Modal: Create Task (POST /api/tasks) -->
<div class="modal fade" id="createTaskModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold">Create Task via API</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="apiCreateTaskForm">
        <div class="modal-body">
          <div class="mb-3">
            <label for="apiTitle" class="form-label">Task Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="apiTitle" placeholder="e.g. Write integration test cases" required minlength="3">
          </div>
          <div class="row g-3 mb-3">
            <div class="col-6">
              <label for="apiPriority" class="form-label">Priority <span class="text-danger">*</span></label>
              <select class="form-select" id="apiPriority" required>
                <option value="">-- Choose --</option>
                <option value="low">Low</option>
                <option value="medium" selected>Medium</option>
                <option value="high">High</option>
                <option value="urgent">Urgent</option>
              </select>
            </div>
            <div class="col-6">
              <label for="apiDueDate" class="form-label">Due Date <span class="text-danger">*</span></label>
              <input type="date" class="form-control" id="apiDueDate" required>
            </div>
          </div>
          <div class="mb-3">
            <label for="apiDescription" class="form-label">Description</label>
            <textarea class="form-control" id="apiDescription" rows="3" placeholder="Task execution parameters..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-top-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-tf">
            <i class="bi bi-cloud-arrow-up me-1"></i> Send POST Request
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Edit Task (PUT /api/tasks/:id) -->
<div class="modal fade" id="editTaskModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold">Edit Task via API</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="apiEditTaskForm">
        <input type="hidden" id="editTaskId">
        <div class="modal-body">
          <div class="mb-3">
            <label for="editTitle" class="form-label">Task Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="editTitle" required minlength="3">
          </div>
          <div class="row g-3 mb-3">
            <div class="col-4">
              <label for="editPriority" class="form-label">Priority</label>
              <select class="form-select" id="editPriority">
                <option value="low">Low</option>
                <option value="medium">Medium</option>
                <option value="high">High</option>
                <option value="urgent">Urgent</option>
              </select>
            </div>
            <div class="col-4">
              <label for="editStatus" class="form-label">Status</label>
              <select class="form-select" id="editStatus">
                <option value="pending">Pending</option>
                <option value="in-progress">In Progress</option>
                <option value="completed">Completed</option>
              </select>
            </div>
            <div class="col-4">
              <label for="editDueDate" class="form-label">Due Date</label>
              <input type="date" class="form-control" id="editDueDate" required>
            </div>
          </div>
          <div class="mb-3">
            <label for="editDescription" class="form-label">Description</label>
            <textarea class="form-control" id="editDescription" rows="3"></textarea>
          </div>
        </div>
        <div class="modal-footer border-top-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-tf">
            <i class="bi bi-save me-1"></i> Send PUT Request
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/footer', { extraJs: '/js/task5-api.js' }) %>
