<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<main class="py-4">
  <div class="container container-xl">
    <!-- Internship Task Header Badge -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="badge bg-success-subtle text-success-emphasis border px-3 py-2 text-uppercase fw-bold letter-spacing-1">Cognifyz Level 3 : Task 6</span>
          <span class="badge bg-light text-dark border">Advanced</span>
        </div>
        <h1 class="h3 fw-bold mb-1">Database Integration and User Authentication</h1>
        <p class="text-muted mb-0">Persistent storage using MongoDB with Mongoose ODM, bcrypt password hashing, session/JWT authentication, and strict multi-user authorization checks.</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/tasks/task-5" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i> Task 5
        </a>
        <a href="/dashboard" class="btn btn-sm btn-primary-tf">
          Full Dashboard <i class="bi bi-speedometer2 ms-1"></i>
        </a>
      </div>
    </div>

    <!-- MongoDB Connection Health & Status Strip -->
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted small fw-semibold">Database Engine</span>
            <span class="badge <%= dbStatus.connected ? 'bg-success' : 'bg-danger' %>">
              <%= dbStatus.connected ? '● Connected' : '○ Disconnected' %>
            </span>
          </div>
          <div class="d-flex align-items-center gap-3">
            <div class="p-3 bg-success-subtle text-success rounded-3">
              <i class="bi bi-database-check fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0 text-dark">MongoDB (Mongoose ODM)</h5>
              <small class="text-muted">Target: <code><%= dbStatus.dbName %></code> @ <%= dbStatus.host %></small>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted small fw-semibold">Security & Cryptography</span>
            <span class="badge bg-primary">Active</span>
          </div>
          <div class="d-flex align-items-center gap-3">
            <div class="p-3 bg-primary-subtle text-primary rounded-3">
              <i class="bi bi-shield-lock-fill fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0 text-dark">bcrypt + Session + JWT</h5>
              <small class="text-muted">10 Salt Rounds • Strict User Isolation • Protected Endpoints</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- User Authentication State Section -->
    <% if (user) { %>
      <!-- Authenticated User View -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-bottom pb-3 mb-3">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-primary text-white rounded-circle p-3 d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
              <i class="bi bi-person-fill fs-4"></i>
            </div>
            <div>
              <h3 class="h5 fw-bold mb-0 text-dark"><%= user.name %></h3>
              <p class="text-muted small mb-0"><%= user.email %> • <span class="badge bg-success-subtle text-success">Authenticated User</span></p>
            </div>
          </div>
          <div class="d-flex gap-2">
            <a href="/dashboard" class="btn btn-sm btn-primary-tf">
              <i class="bi bi-speedometer2 me-1"></i> Open Production Dashboard
            </a>
            <a href="/auth/logout" class="btn btn-sm btn-outline-danger">
              <i class="bi bi-box-arrow-right me-1"></i> Sign Out
            </a>
          </div>
        </div>

        <!-- Persistent Tasks Header & Stats -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
          <h4 class="h6 fw-bold mb-0 text-dark">
            <i class="bi bi-layers me-2 text-primary"></i> Persistent MongoDB Tasks (<%= tasks ? tasks.length : 0 %>)
          </h4>
          <span class="text-muted small">Scoped strictly to User ID: <code><%= user._id %></code></span>
        </div>

        <% if (tasks && tasks.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-light small">
                <tr>
                  <th>Task Title</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th>Due Date</th>
                  <th>MongoDB ID</th>
                </tr>
              </thead>
              <tbody>
                <% tasks.forEach(function(task) { %>
                  <tr>
                    <td>
                      <span class="fw-bold text-dark"><%= task.title %></span>
                      <% if (task.description) { %>
                        <div class="text-muted small text-truncate" style="max-width: 300px;"><%= task.description %></div>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge badge-priority-<%= task.priority %> text-capitalize"><%= task.priority %></span>
                    </td>
                    <td>
                      <span class="badge badge-status-<%= task.status %> text-capitalize"><%= task.status.replace('-', ' ') %></span>
                    </td>
                    <td class="small text-muted">
                      <%= new Date(task.dueDate).toISOString().split('T')[0] %>
                    </td>
                    <td>
                      <code class="small text-muted"><%= task._id %></code>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-database-add fs-1 d-block mb-2 text-secondary opacity-50"></i>
            <h5>No persistent tasks found in MongoDB</h5>
            <p class="small mb-3">Your user document has zero registered tasks yet. Add tasks from the production dashboard!</p>
            <a href="/dashboard" class="btn btn-primary-tf btn-sm">
              <i class="bi bi-plus-lg me-1"></i> Go to Dashboard & Add Task
            </a>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <!-- Unauthenticated View: Sign In / Demo Login Prompt -->
      <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center mb-4">
        <div class="max-w-600 mx-auto" style="max-width: 550px;">
          <div class="bg-primary-subtle text-primary rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
            <i class="bi bi-shield-lock-fill fs-2"></i>
          </div>
          <h2 class="h4 fw-bold text-dark mb-2">Protected Authentication Workspace</h2>
          <p class="text-muted mb-4">
            Task 6 requires user authentication so that tasks are securely persisted in MongoDB and strictly isolated by user credentials. Sign in or register to test live database operations.
          </p>
          <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/auth/login" class="btn btn-primary-tf px-4 py-2">
              <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            </a>
            <a href="/auth/register" class="btn btn-outline-primary px-4 py-2">
              <i class="bi bi-person-plus me-1"></i> Register New User
            </a>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Authorization & Architecture Callout -->
    <div class="card border-0 rounded-4 p-4 shadow-sm" style="background: linear-gradient(135deg, #F8FAFC, #F1F5F9); border-left: 5px solid #10B981 !important;">
      <h3 class="h6 fw-bold text-dark d-flex align-items-center gap-2 mb-2">
        <i class="bi bi-shield-check text-success"></i> Cognifyz Level 3 Task 6 Security Architecture
      </h3>
      <div class="row g-3 small text-muted">
        <div class="col-md-4">
          <strong>1. Password Hashing (bcrypt):</strong><br>
          Passwords are salted and hashed with 10 rounds before storing. Raw passwords are never kept in memory or database.
        </div>
        <div class="col-md-4">
          <strong>2. Protected API Endpoints:</strong><br>
          Middleware blocks unauthenticated requests with <code>401 Unauthorized</code>. Session cookies and Bearer JWTs are verified.
        </div>
        <div class="col-md-4">
          <strong>3. Strict User Authorization:</strong><br>
          Every task query filters by <code>user: req.user._id</code>. Cross-user modification or deletion returns <code>403 Forbidden</code>.
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../layouts/footer') %>
