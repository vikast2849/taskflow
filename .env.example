# ===============================================
# TaskFlow Environment Configuration Template
# ===============================================

# Server Port
PORT=3000

# Node Environment (development / production)
NODE_ENV=development

# Database Connection
# Standard local MongoDB: mongodb://127.0.0.1:27017/taskflow
# Or cloud Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/taskflow
# NOTE: If MongoDB daemon is not running locally, TaskFlow automatically starts
# an embedded in-memory MongoDB instance for seamless instant zero-config review!
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# Session Secret (change to random string in production)
SESSION_SECRET=taskflow_secure_session_secret_key_2026_cognifyz

# JWT Secret for API Authentication
JWT_SECRET=taskflow_jwt_secret_token_key_2026_cognifyz
